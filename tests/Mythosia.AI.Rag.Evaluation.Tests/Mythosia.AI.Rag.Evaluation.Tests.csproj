<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.2.1" />
    <ProjectReference Include="../Mythosia.AI.Rag.Evaluation/Mythosia.AI.Rag.Evaluation.csproj" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Mythosia.AI.Rag.Evaluation/Datasets/smoke.json" Link="Fixtures/smoke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Mythosia.AI.Rag.Evaluation/Datasets/Baselines/smoke-local-hash.json" Link="Fixtures/smoke-local-hash.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
