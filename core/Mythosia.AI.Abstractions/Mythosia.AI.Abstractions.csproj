<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI" />
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

	<PropertyGroup>
		<PackageId>Mythosia.AI.Abstractions</PackageId>
		<IsPackable>true</IsPackable>
		<Company>Mythosia</Company>
		<PackageTags>AI;Abstractions;IAIService;Models;Streaming</PackageTags>
		<Authors>JJW</Authors>
		<Description>Core abstractions and shared models for Mythosia.AI. Defines IAIService interface, Message, ChatBlock, StreamingContent, FunctionDefinition, and other contract types. Zero heavy dependencies.</Description>
		<PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/core/Mythosia.AI.Abstractions</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>v1.0.0: Initial release ? IAIService interface, shared models (Message, ChatBlock, StreamingContent, FunctionDefinition, etc.), extracted from Mythosia.AI for lightweight dependency.</PackageReleaseNotes>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Mythosia" Version="1.4.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
