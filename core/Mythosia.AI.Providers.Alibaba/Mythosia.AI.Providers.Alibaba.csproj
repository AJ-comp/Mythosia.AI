<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI.Providers.Alibaba</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <Authors>JJW</Authors>
    <PackageTags>AI; Alibaba; Qwen; vLLM; Ollama; LLM; Chat Completion; Streaming; Function Calling;</PackageTags>
    <Description>
Alibaba Cloud Qwen provider package for Mythosia.AI.

Includes QwenService with expanded Qwen 3 / 3.5 model constants, Qwen 3.5-specific thinking request handling across `vLLM` and `Ollama`, and Mythosia.AI v5.0.0 request-profile integration for per-request reasoning disablement.

Documentation
- GitHub: https://github.com/AJ-comp/Mythosia.AI
- Release Notes: core/Mythosia.AI.Providers.Alibaba/RELEASE_NOTES.md
    </Description>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/core/Mythosia.AI.Providers.Alibaba</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.0: Added expanded AlibabaModels coverage for Qwen 3 / 3.5 models, Qwen 3.5-specific thinking request handling, and AIRequestProfile.DisableReasoning integration for request-scoped reasoning control.</PackageReleaseNotes>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.AI\Mythosia.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TiktokenSharp" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
