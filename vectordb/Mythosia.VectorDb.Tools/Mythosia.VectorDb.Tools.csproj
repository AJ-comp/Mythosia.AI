<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.VectorDb.Tools</PackageId>
    <IsPackable>true</IsPackable>
    <Version>10.0.3</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Package Manager Console tools for Mythosia VectorDb providers, including Qdrant migration and copy support. Install via NuGet and use commands directly in PMC.</Description>

    <!-- PMC tool packaging (same model as Microsoft.EntityFrameworkCore.Tools) -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <DevelopmentDependency>true</DevelopmentDependency>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
    <ProjectReference Include="..\Mythosia.VectorDb.Qdrant\Mythosia.VectorDb.Qdrant.csproj" />
  </ItemGroup>

  <!-- PowerShell scripts for PMC integration -->
  <ItemGroup>
    <None Include="tools\init.ps1" Pack="true" PackagePath="tools\" />
    <None Include="tools\Mythosia.VectorDb.Tools.psm1" Pack="true" PackagePath="tools\" />
  </ItemGroup>

  <!-- Bundle build output into tools folder inside the NuGet package -->
  <Target Name="_PackToolFiles" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ToolBuildOutput Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.exe;$(OutputPath)publish\**" />
      <_PackageFiles Include="@(_ToolBuildOutput)">
        <PackagePath>tools/$(TargetFramework)/any/%(RecursiveDir)</PackagePath>
      </_PackageFiles>
    </ItemGroup>
  </Target>

</Project>
