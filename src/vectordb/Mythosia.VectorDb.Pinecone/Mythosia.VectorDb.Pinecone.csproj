<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.VectorDb.Pinecone</PackageId>
    <IsPackable>true</IsPackable>
    <Version>4.0.1</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Pinecone vector store implementation for Mythosia VectorDb. Uses Pinecone index as physical storage with optional PineconeOptions.Namespace for data isolation, metadata filtering, GetBatchAsync, CountAsync, and connection verification.</Description>
    <PackageTags>VectorDB;VectorStore;Pinecone;Embeddings;RAG;Count;BatchGet</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageReleaseNotes>v4.0.1: Recompiled against System.IO.Hashing 10.0.6 and System.Text.Json 10.0.6. No behavioral changes.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.7" />
    <PackageReference Include="System.Text.Json" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
