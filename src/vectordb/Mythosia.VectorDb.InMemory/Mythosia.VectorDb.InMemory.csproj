<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.VectorDb.InMemory</PackageId>
    <IsPackable>true</IsPackable>
    <Version>4.2.0</Version>
    <!-- This existing stable package intentionally retains its pinned Lucene prerelease
         dependencies. Keep NU5104 visible without making this known warning fatal. -->
    <WarningsNotAsErrors Condition="'$(Version)' == '4.2.0'">$(WarningsNotAsErrors);NU5104</WarningsNotAsErrors>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>In-memory vector and BM25 text search for Mythosia VectorDb. Provides cosine similarity, text-only retrieval, configurable normalized weighted RRF, metadata filtering, upsert/delete operations, batch retrieval and counts. Filters candidates before truncation, synchronizes record and keyword-index access, and returns independent record copies. Supports cancellation while waiting for access and between batch records; batch and document replacement operations do not provide transactional rollback. What's New in v4.2.0: Text search, configurable hybrid search and consistent concurrent record/index access.</Description>
    <PackageTags>VectorDB;VectorStore;InMemory;CosineSimilarity;BM25;HybridSearch;RRF;Count;BatchGet</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v4.2.0: Adds text-only BM25 search and configurable normalized weighted RRF. Applies filtering before candidate truncation and honors vector weight, candidate multiplier and RRF smoothing. Synchronizes records and keyword indexes across reads/writes, copies input/output records and observes cancellation while waiting and between batch records. Completed records remain consistent, but batch writes and sequential replacement are not transactional. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/vectordb/Mythosia.VectorDb.InMemory/RELEASE_NOTES.md#v420</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
    <ProjectReference Include="..\..\rag\Mythosia.AI.Rag.Abstractions\Mythosia.AI.Rag.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00016" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00016" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
