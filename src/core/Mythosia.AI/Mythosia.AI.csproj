<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <PackageTags>AI;LLM;OpenAI;Anthropic;Claude;Google;Gemini;xAI;Grok;DeepSeek;Perplexity;ImageGeneration;ImageEditing;Multimodal;Reasoning;FunctionCalling;AsyncFunctionCalling;ParallelFunctionCalling;StructuredOutput;Streaming;Run;Steering;WebSearch;FileSearch;Citations</PackageTags>
    <Authors>JJW</Authors>
    <Description>Provider-neutral .NET library for OpenAI, Anthropic Claude, Google Gemini, xAI Grok, DeepSeek, and Perplexity. Provides text and multimodal completions, controllable runs with streaming and cancellation, GPT-6 Astra steering and opt-in asynchronous tools, common reasoning and hosted search with citations, structured output, token usage, context recovery, ordered function-call batches, and optional OpenAI/Gemini image generation and editing. Feature support is validated per provider and model. Requires Mythosia.AI.Abstractions 3.1.0. Targets .NET Standard 2.1.</Description>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v7.1.0 adds GPT-6 Astra, StartRunAsync with result/stream/cancellation and supported steering, opt-in native asynchronous tools, and common reasoning, hosted search, and citations. Preserves accepted cache-aware reasoning changes and rolls back failed changes. Legacy Agent methods now warn; existing completion and streaming APIs remain supported. Requires Mythosia.AI.Abstractions 3.1.0. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI/RELEASE_NOTES.md#v710</PackageReleaseNotes>
    <Version>7.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.10" />
    <PackageReference Include="TiktokenSharp" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
