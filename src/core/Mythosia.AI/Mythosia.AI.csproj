<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <PackageTags>AI; Grok; xAI; Grok4; Grok3; Gpt5; Gpt5.1; Gpt5.2; Gpt5.2Codex; Gpt5.3; Gpt5.3Codex; Gpt5.4; Gpt5.4Pro; Gpt5.4Mini; Gpt5.4Nano; ChatGpt;
    Claude Opus 4.6; Claude Sonnet 4.6; Claude Opus 4.5; Claude Sonnet 4.5; Claude Haiku 4.5; Claude;
    DeepSeek; Sonar; Gemini; Gemini2.5; Gemini3; Reasoning; Multi modal;</PackageTags>
    <Authors>JJW</Authors>
    <Description>
		## What's New in v6.2.0

		### Round-Level Token Usage
		- Added StreamingContentType.RoundUsage events for per-LLM-round token usage during streaming.
		- RoundUsage.Usage reports only the current LLM round, while Completion.Usage remains cumulative for the whole streaming run.
		- Added StreamingContent.RoundIndex and StreamingContent.IsFinalRound through Mythosia.AI.Abstractions v2.1.0.
		- Gemini streaming now drains after function-call chunks so late usage metadata can be captured before the next round.

		Requires Mythosia.AI.Abstractions v2.1.0.

		---

		## Documentation
		- Basic Usage: https://github.com/AJ-comp/Mythosia.AI/wiki
		- Advanced Features: https://github.com/AJ-comp/Mythosia.AI/wiki/Advanced-Features
		- Release Notes: https://github.com/AJ-comp/Mythosia.AI/wiki/Release-Notes
		- GitHub: https://github.com/AJ-comp/Mythosia.AI
	</Description>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v6.2.0: add StreamingContentType.RoundUsage events with per-round TokenUsage, RoundIndex, and IsFinalRound. Completion.Usage remains cumulative. Gemini streaming drains after function-call chunks to capture late usage metadata. Requires Mythosia.AI.Abstractions v2.1.0.</PackageReleaseNotes>
    <Version>6.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NJsonSchema" Version="11.6.0" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.6" />
    <PackageReference Include="TiktokenSharp" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
