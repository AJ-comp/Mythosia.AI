<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <PackageTags>AI;LLM;OpenAI;GPT6;GPT-6;Astra;GPT6Sol;GPT6Luna;Anthropic;Claude;Opus5.5;Fable5.1;Google;Gemini;xAI;Grok4.7;Grok4.6;DeepSeek;Perplexity;ImageGeneration;ImageEditing;GPTImage2.5;GrokImagine;Multimodal;Reasoning;FunctionCalling;StructuredOutput;Streaming;Run;Steering;WebSearch;FileSearch;Citations;RequestBuilder;Capabilities;Cancellation;InferenceSpeed;FastMode;PriorityProcessing</PackageTags>
    <Authors>JJW</Authors>
    <Description>Build .NET applications that use multiple AI providers through consistent completion, streaming and tool workflows. Supports OpenAI GPT-6 Astra/Sol/Luna, Anthropic including Claude Opus 5.5, Google, xAI including Grok 4.7, DeepSeek Flash/V4 Pro and Perplexity with immutable requests, controllable runs, structured output, cancellable local tools, reasoning, search and citations. DeepSeek offers optional Responses execution and reusable image Files. Typed image generation/editing, local capability inspection and per-request processing-speed choices include requested/applied observations. Targets .NET Standard 2.1 and uses the shared Mythosia.AI.Abstractions contracts.</Description>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Unreleased (next version not assigned): Adds GPT-6 Sol/Luna, Claude Opus 5.5, Grok 4.7 and text-only DeepSeek V4 Pro, optional DeepSeek Responses execution and reusable image Files, plus per-request processing speed and requested/applied observations. Existing service defaults remain. Aligns Google image-option validation with model capabilities, preserves RAG tool continuations and isolates stored summaries from stateless requests. Full pending notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI/RELEASE_NOTES.md#unreleased. Previous version notes: v8.0.0 is a coordinated major release with Mythosia.AI.Abstractions 4.0.0. Adds typed image quality/background/format and Pixels/Preset sizing, immutable CreateRequest builders, asynchronous tool object returns and cancellation, ordinary completion cancellation, AIRunResult snapshots, and local model-capability inspection. Update image option callers, read (await run.Result).Text, and rebuild completion consumers/custom implementations. GetCompletionAsync remains a string API. Adds Fable/Mythos 5.1, Gemini 3.7/3.8 Flash, Grok 4.6, DeepSeek Flash, Grok Imagine Image 2.0 and GPT Image 2.5 selections; Perplexity moves to Agent/Search/background APIs with an explicit Sonar migration. Reliability fixes cover request snapshots, tool cleanup, token totals/overflow, stream terminal validation, image payloads and structured retry limits. Cancellation stops cooperative client work without guaranteeing remote inference/billing cancellation. Migration: https://github.com/AJ-comp/Mythosia.AI/blob/main/docs/v8-migration.md Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI/RELEASE_NOTES.md#v800</PackageReleaseNotes>
    <Version>8.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.10" />
    <PackageReference Include="TiktokenSharp" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
