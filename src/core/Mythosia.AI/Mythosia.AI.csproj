  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <PackageTags>AI; Grok; xAI; Grok4; Grok3; Gpt5; Gpt5.1; Gpt5.2; Gpt5.2Codex; Gpt5.3; Gpt5.3Codex; Gpt5.4; Gpt5.4Pro; Gpt5.4Mini; Gpt5.4Nano; ChatGpt;
