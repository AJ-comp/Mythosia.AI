<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <PackageTags>AI;LLM;OpenAI;Anthropic;Claude;Google;Gemini;xAI;Grok;DeepSeek;Perplexity;ImageGeneration;ImageEditing;Multimodal;Reasoning;FunctionCalling;ParallelFunctionCalling;StructuredOutput;Streaming</PackageTags>
    <Authors>JJW</Authors>
    <Description>Provider-neutral .NET library for OpenAI, Anthropic Claude, Google Gemini, xAI Grok, DeepSeek, and Perplexity. Provides text and multimodal completions, streaming, reasoning, structured output, token usage, context recovery, ordered function-call batches with sequential or bounded-parallel handler execution, and optional OpenAI/Gemini image generation and editing. Targets .NET Standard 2.1.</Description>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v7.0.0 is a breaking major release. Adds current OpenAI, Anthropic, Gemini, and xAI model contracts; provider-neutral image generation/editing; and ordered multi-function batches with sequential or bounded-parallel local handler execution. Strengthens terminal-response, continuation, refusal, malformed-tool, and usage handling across providers. Removes the legacy image methods, message-count windowing, unsafe function-message removal, retired model constants, GrokReasoning.Off, and single-function custom-provider extension signatures. Requires Mythosia.AI.Abstractions v3.0.0. Full notes and migration guide: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI/RELEASE_NOTES.md#v700</PackageReleaseNotes>
    <Version>7.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.10" />
    <PackageReference Include="TiktokenSharp" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
