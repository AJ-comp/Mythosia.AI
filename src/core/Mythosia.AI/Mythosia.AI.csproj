  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mythosia.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Company>Mythosia</Company>
    <PackageTags>AI; Grok; xAI; Grok4.3; Grok4.20; GrokBuild; Gpt5; Gpt5.1; Gpt5.2; Gpt5.2Codex; Gpt5.3Codex; Gpt5.4; Gpt5.4Pro; Gpt5.5; Gpt5.5Pro; Gpt5Pro; ChatGpt;
