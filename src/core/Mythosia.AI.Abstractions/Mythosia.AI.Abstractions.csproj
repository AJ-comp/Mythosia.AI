<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI" />
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

	<PropertyGroup>
		<PackageId>Mythosia.AI.Abstractions</PackageId>
		<IsPackable>true</IsPackable>
		<Company>Mythosia</Company>
		<PackageTags>AI;LLM;Abstractions;IAIService;IAIRunService;IImageGenerationService;Messages;Streaming;FunctionCalling;Run;Citations;ImageGeneration;ImageEditing;ImageSize;ImageQuality;Capabilities;Cancellation;GPT6;GPT6Sol;GPT6Luna;Claude;Opus5.5;Grok4.7;InferenceSpeed;Processing</PackageTags>
		<Authors>JJW</Authors>
		<Description>Use shared AI contracts in middleware, RAG integrations and custom providers without depending on provider SDKs. Defines IAIService, optional Run/request-feature/image interfaces, messages, streaming events, tools, typed image options, AIRunResult, processing-speed choices and observations, and immutable model-capability snapshots. Includes shared identifiers for GPT-6 Sol/Luna, Claude Opus 5.5, Grok 4.7 and DeepSeek V4 Pro, plus Perplexity Agent API contracts. Provider execution is supplied by Mythosia.AI 8.1.0. What's New in v4.1.0: additional model identifiers and optional processing-speed contracts. Depends only on the lightweight Mythosia base package.</Description>
		<PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/src/core/Mythosia.AI.Abstractions</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>v4.1.0 adds GPT-6 Sol/Luna, Claude Opus 5.5, Grok 4.7 and DeepSeek V4 Pro identifiers, Gpt6Reasoning.None, and optional processing-speed request, capability and observation contracts. Existing required interface members, constructors and enum values are retained. Mythosia.AI 8.1.0 supplies provider validation and execution. Recognizes explicit xAI input-too-large context errors without treating unrelated failures as compaction signals. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI.Abstractions/RELEASE_NOTES.md#v410</PackageReleaseNotes>

		<Version>4.1.0</Version>

	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Mythosia" Version="1.4.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Update="RELEASE_NOTES.md">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
