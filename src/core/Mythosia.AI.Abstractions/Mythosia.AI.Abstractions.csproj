<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI" />
    <InternalsVisibleTo Include="Mythosia.AI.Test" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

	<PropertyGroup>
		<PackageId>Mythosia.AI.Abstractions</PackageId>
		<IsPackable>true</IsPackable>
		<Company>Mythosia</Company>
		<PackageTags>AI;LLM;Abstractions;IAIService;IAIRunService;IImageGenerationService;Messages;Streaming;FunctionCalling;Run;Citations;ImageGeneration;ImageEditing;ImageSize;ImageQuality;Capabilities;Cancellation;GPT6;GPT6Sol;GPT6Luna;Claude;Opus5.5;Grok4.7;InferenceSpeed;Processing</PackageTags>
		<Authors>JJW</Authors>
		<Description>Use shared AI contracts in middleware, RAG integrations and custom providers without depending on provider SDKs. Defines IAIService, optional Run/request-feature/image interfaces, messages, streaming events, tools, typed image options, AIRunResult, processing-speed choices and observations, and immutable model-capability snapshots. Includes shared identifiers for GPT-6 Sol/Luna, Claude Opus 5.5, Grok 4.7 and DeepSeek V4 Pro, plus Perplexity Agent API contracts. Provider execution is supplied by the matching core implementation. Depends only on the lightweight Mythosia base package.</Description>
		<PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/src/core/Mythosia.AI.Abstractions</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Unreleased (next version not assigned): Adds identifiers for GPT-6 Sol/Luna, Claude Opus 5.5, Grok 4.7 and DeepSeek V4 Pro, additive Gpt6Reasoning.None, and processing-speed request, capability and observation contracts. No required interface members are added. The matching unreleased core supplies provider validation and execution; this package contains shared contracts and model identifiers. Full pending notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI.Abstractions/RELEASE_NOTES.md#unreleased. Previous version notes: v4.0.0 supplies the contracts for Mythosia.AI 8.0.0. Major migrations: image options use enums and ImageSize instead of strings/separate AspectRatio; IAIService completion signatures append CancellationToken; AIRun.Result returns Task&lt;AIRunResult&gt;. Update custom implementations and rebuild consumers; ordinary completion still returns a string. Adds cancellation-aware tool handlers, explicit cancelled results, tri-state AI/image capabilities, current Claude/Gemini/Grok/DeepSeek and GPT Image 2.5 identifiers, and Perplexity Agent API contracts replacing legacy Sonar selections. Snapshots preserve supported JSON ownership, array bounds, read-only wrappers, dictionary comparers and shared references without adding a JSON dependency. Explicit provider token totals remain intact. Migration: https://github.com/AJ-comp/Mythosia.AI/blob/main/docs/v8-migration.md Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/core/Mythosia.AI.Abstractions/RELEASE_NOTES.md#v400</PackageReleaseNotes>

		<Version>4.0.0</Version>

	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Mythosia" Version="1.4.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Update="RELEASE_NOTES.md">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
