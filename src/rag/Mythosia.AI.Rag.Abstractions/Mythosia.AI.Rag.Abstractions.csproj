<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Version>6.4.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Shared contracts for Mythosia RAG loading, splitting, embeddings, retrieval, reranking and context building. IRagRetriever and RagRetrievalRequest support text, lexical overrides, top-K, filters, progress and cancellation without requiring a query embedding. Optional IRetrievalEmbeddingProvider distinguishes document and query embeddings, while EmbeddingDocument snapshots document identity, title and ordered chunks. Retains IEmbeddingProvider and IRetrievalStrategy for existing implementations. Includes RagDocument, RagChunk and cloneable pipeline/query options. What's New in v6.4.0: Compatible retrieval embedding extensions for full-document context and explicit query purpose.</Description>
    <PackageTags>AI;RAG;Abstractions;VectorStore;Embedding;ContextualizedEmbedding;TextSplitter;HybridSearch;Reranking;MetadataFilter</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/src/rag/Mythosia.AI.Rag.Abstractions</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v6.4.0: Adds optional IRetrievalEmbeddingProvider and immutable EmbeddingDocument for document/query-aware embeddings with complete ordered document chunks. Existing IEmbeddingProvider signatures remain unchanged. Documents vector ownership, count/dimension/finite-value requirements, cancellation and provider-owned request batching without silent contextual splitting. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/rag/Mythosia.AI.Rag.Abstractions/RELEASE_NOTES.md#v640</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

