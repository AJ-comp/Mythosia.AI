<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Version>6.1.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Core abstractions for Mythosia.AI RAG pipeline. Defines ITextSplitter, IEmbeddingProvider, IContextBuilder, IRetrievalStrategy, IReranker interfaces, RagDocument, RagQueryOptions (with StoreFilter), and shared models. RagDocument is self-contained.</Description>
    <PackageTags>AI;RAG;Abstractions;VectorStore;Embedding;TextSplitter;HybridSearch;Reranking;MetadataFilter</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/rag/Mythosia.AI.Rag.Abstractions</PackageProjectUrl>
    <PackageReleaseNotes>v6.1.0: Namespace concept removed entirely. RagQueryOptions.Namespace, RagPipelineOptions.DefaultScope, RagQueryDiagnostics.AppliedNamespace, and IRagDiagnosticsStore namespace parameters are all removed. For logical isolation use metadata conditions via VectorFilter.Where("tenant", value) or VectorFilter.Where("category", value).</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>

