<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Version>6.5.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Shared contracts for Mythosia RAG loading, splitting, embeddings, retrieval, reranking and context building. IRagRetriever and RagRetrievalRequest support text, lexical overrides, top-K, filters, progress and cancellation without requiring a query embedding. Optional IRetrievalEmbeddingProvider distinguishes document and query embeddings, while EmbeddingDocument snapshots document identity, title and ordered chunks. Retains IEmbeddingProvider and IRetrievalStrategy for existing implementations. Includes RagDocument, RagChunk and cloneable pipeline/query options. What's New in v6.5.0: Obsolete IRagDiagnosticsStore compatibility bridge to the independent IVectorStoreDiagnostics contract.</Description>
    <PackageTags>AI;RAG;Abstractions;VectorStore;Embedding;ContextualizedEmbedding;TextSplitter;HybridSearch;Reranking;MetadataFilter;Diagnostics;IVectorStoreDiagnostics</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/src/rag/Mythosia.AI.Rag.Abstractions</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v6.5.0: Retains IRagDiagnosticsStore in its original assembly and namespace as an obsolete compatibility interface inheriting IVectorStoreDiagnostics, with original members and default bridges. Public methods take precedence over default bridges; RAG 9.0.0 preserves explicit legacy dispatch through an adapter. Requires VectorDb.Abstractions 4.2.0. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/rag/Mythosia.AI.Rag.Abstractions/RELEASE_NOTES.md#v650</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

