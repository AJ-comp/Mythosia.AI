<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Version>6.3.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Shared contracts for Mythosia RAG loading, splitting, embeddings, retrieval, reranking and context building. IRagRetriever and RagRetrievalRequest support query text, lexical overrides, top-K, filters, progress and cancellation without requiring a query embedding. Retains IRetrievalStrategy for existing dense-input implementations. Includes self-contained RagDocument, RagChunk and cloneable pipeline/query options for per-query configuration. What's New in v6.3.0: Optional request-based retriever contracts alongside the existing dense-input strategy.</Description>
    <PackageTags>AI;RAG;Abstractions;VectorStore;Embedding;TextSplitter;HybridSearch;Reranking;MetadataFilter</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/src/rag/Mythosia.AI.Rag.Abstractions</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v6.3.0: Adds IRagRetriever and RagRetrievalRequest for request-based retrieval without mandatory query embeddings. Requests carry full/lexical query text, top-K, filters and optional progress; RetrieveAsync accepts cancellation. Existing IRetrievalStrategy implementations remain supported. Built-in retrievers use the full query for a null lexical override and skip text search for an empty override. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/rag/Mythosia.AI.Rag.Abstractions/RELEASE_NOTES.md#v630</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.Abstractions\Mythosia.VectorDb.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

