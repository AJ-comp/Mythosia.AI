<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag</PackageId>
    <IsPackable>true</IsPackable>
    <Version>7.0.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>RAG (Retrieval Augmented Generation) orchestration for Mythosia.AI. Implements Mythosia.AI.Rag.Abstractions v5.x. Includes RagPipeline, text splitters, context builder, OpenAI/vLLM embedding providers, hybrid search (BM25 + Vector + RRF), re-ranking (Cohere, LLM, vLLM), search gate, keyword extraction, weighted-blend final selection, progress reporting, DoclingDocument-to-RagDocument conversion, and per-query VectorFilter passthrough (StoreFilter). Depends on Mythosia.AI.Abstractions (IAIService) instead of the full Mythosia.AI implementation.</Description>
    <PackageTags>AI;RAG;Pipeline;TextSplitter;Embedding;ContextBuilder;HybridSearch;BM25;Reranking;MetadataFilter</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/rag/Mythosia.AI.Rag</PackageProjectUrl>
    <PackageReleaseNotes>v7.0.0: Requires Abstractions v3.0.0, VectorDb.InMemory v3.0.0, and Rag.Abstractions v6.0.0 — VectorFilter.ByMetadata/ByNamespace/ByScope and MetadataMatch are removed. Users of RagQueryOptions.StoreFilter must migrate to new fluent API: new VectorFilter().Where(...). Internal MergeStoreFilter uses AppendConditionsFrom; DeleteDocumentAsync uses .Where().</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\loaders\Mythosia.Documents.Office\Mythosia.Documents.Office.csproj" />
    <ProjectReference Include="..\..\loaders\Mythosia.Documents.Pdf\Mythosia.Documents.Pdf.csproj" />
    <ProjectReference Include="..\Mythosia.AI.Rag.Abstractions\Mythosia.AI.Rag.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.InMemory\Mythosia.VectorDb.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Rag.Tests" />
  </ItemGroup>

</Project>

