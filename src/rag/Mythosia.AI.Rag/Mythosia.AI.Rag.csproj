<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag</PackageId>
    <IsPackable>true</IsPackable>
    <Version>8.0.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>Ground AI answers in application-managed documents with loading, splitting, embeddings, hybrid retrieval, reranking and metadata filters. Provides RAG and Agentic RAG tools, streaming runs, cooperative cancellation and supported reasoning/search forwarding. Includes Perplexity standard embeddings and separate contextualized document-group APIs with explicit binary-vector results. Requires Mythosia.AI.Abstractions 4.0.0 and Mythosia.AI.Rag.Abstractions 6.2.0; no dependency on the full Mythosia.AI implementation.</Description>
    <PackageTags>AI;RAG;AgenticRag;TextSplitter;Embedding;HybridSearch;BM25;Reranking;MetadataFilter;Run;Streaming;Reasoning;Perplexity;ContextualizedEmbedding;BinaryEmbedding;Cancellation</PackageTags>
    <PackageProjectUrl>https://aj-comp.github.io/Mythosia.AI/docs/rag.html</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v8.0.0 aligns RAG with Mythosia.AI.Abstractions 4.0.0 while retaining the independent retrieval architecture and Mythosia.AI.Rag.Abstractions 6.2.0 contract. Completion propagates CancellationToken through retrieval, rewriting and the inner service; Agentic RAG forwards the tool token into retrieval and reports search failures as failed tool results. RAG runs expose AIRunResult: use (await run.Result).Text for the answer or inspect the inner model usage, citations, model, rounds and finish details without a stream reader. Retrieval/embedding usage is separate. Rebuild callers for the changed completion/Run contracts; ordinary RAG completion remains a string API. Adds Perplexity standard 0.6B/4B embeddings, contextualized document-group APIs and explicit packed binary vectors. Use Mythosia.AI 8.0.0 for its new provider controls when choosing the inner service. Migration: https://github.com/AJ-comp/Mythosia.AI/blob/main/docs/v8-migration.md Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/rag/Mythosia.AI.Rag/RELEASE_NOTES.md#v800</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\loaders\Mythosia.Documents.Office\Mythosia.Documents.Office.csproj" />
    <ProjectReference Include="..\..\loaders\Mythosia.Documents.Pdf\Mythosia.Documents.Pdf.csproj" />
    <ProjectReference Include="..\Mythosia.AI.Rag.Abstractions\Mythosia.AI.Rag.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.InMemory\Mythosia.VectorDb.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Rag.Tests" />
  </ItemGroup>

</Project>

