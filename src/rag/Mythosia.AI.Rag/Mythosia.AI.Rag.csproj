<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag</PackageId>
    <IsPackable>true</IsPackable>
    <Version>7.6.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>RAG (Retrieval Augmented Generation) orchestration for Mythosia.AI, with document loading, splitting, embeddings, hybrid search, reranking, metadata filters, and Agentic RAG tools. Adds Run execution with streaming, cancellation, and supported steering, plus request-scoped reasoning and hosted-search forwarding. Requires Mythosia.AI.Abstractions 3.1.0 and Mythosia.AI.Rag.Abstractions 6.2.0; does not depend on the full Mythosia.AI implementation.</Description>
    <PackageTags>AI;RAG;AgenticRag;Pipeline;TextSplitter;Embedding;ContextBuilder;HybridSearch;BM25;Reranking;MetadataFilter;Observability;Run;Streaming;Reasoning;Search</PackageTags>
    <PackageProjectUrl>https://aj-comp.github.io/Mythosia.AI/docs/rag.html</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AJ-comp/Mythosia.AI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v7.6.0 adds RagEnabledService.StartRunAsync with one retrieval pass, streaming, cancellation, and supported steering; forwards request-scoped reasoning and hosted search to the final answer; and fixes all-duplicate source lists being embedded again. Existing completion and streaming APIs remain available. Requires Mythosia.AI.Abstractions 3.1.0 and Mythosia.AI.Rag.Abstractions 6.2.0. Full notes: https://github.com/AJ-comp/Mythosia.AI/blob/main/src/rag/Mythosia.AI.Rag/RELEASE_NOTES.md#v760</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\loaders\Mythosia.Documents.Office\Mythosia.Documents.Office.csproj" />
    <ProjectReference Include="..\..\loaders\Mythosia.Documents.Pdf\Mythosia.Documents.Pdf.csproj" />
    <ProjectReference Include="..\Mythosia.AI.Rag.Abstractions\Mythosia.AI.Rag.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Mythosia.AI.Abstractions\Mythosia.AI.Abstractions.csproj" />
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.InMemory\Mythosia.VectorDb.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="RELEASE_NOTES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Rag.Tests" />
  </ItemGroup>

</Project>

