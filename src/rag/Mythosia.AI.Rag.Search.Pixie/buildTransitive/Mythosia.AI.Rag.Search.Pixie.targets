<Project>
  <!-- contentFiles alone are not propagated through another NuGet package. Explicit
       transitive content also preserves the runtime path in dotnet publish output. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/models/pixie/model.int8.onnx;$(MSBuildThisFileDirectory)../contentFiles/any/any/models/pixie/tokenizer.json;$(MSBuildThisFileDirectory)../contentFiles/any/any/models/pixie/manifest.json;$(MSBuildThisFileDirectory)../contentFiles/any/any/models/pixie/LICENSE">
      <Link>models/pixie/%(Filename)%(Extension)</Link>
      <TargetPath>models/pixie/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>
</Project>
