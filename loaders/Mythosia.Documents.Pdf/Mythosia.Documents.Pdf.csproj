<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.Documents.Pdf</PackageId>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>PDF document loader. Parses PDF files into DoclingDocument structured models via PdfPig. Supports encrypted PDFs, metadata extraction, and page number headers.</Description>
    <PackageTags>Document;DocumentLoader;Pdf;PdfPig</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI</PackageProjectUrl>
    <PackageReleaseNotes>v1.0.0: Initial release as Mythosia.Documents.Pdf. PdfDocumentLoader returning DoclingDocument. PdfPig-based parser with PdfParserOptions (Password, IncludeMetadata, IncludePageNumbers, NormalizeWhitespace).</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mythosia.Documents.Abstractions\Mythosia.Documents.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

</Project>
