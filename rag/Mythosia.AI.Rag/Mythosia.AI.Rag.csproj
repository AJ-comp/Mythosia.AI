<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Mythosia.AI.Rag</PackageId>
    <IsPackable>true</IsPackable>
    <Version>5.0.0</Version>
    <Authors>JJW</Authors>
    <Company>Mythosia</Company>
    <Description>RAG (Retrieval Augmented Generation) orchestration for Mythosia.AI. Implements Mythosia.AI.Rag.Abstractions v4.x. Includes RagPipeline, text splitters, context builder, OpenAI/vLLM embedding providers, hybrid search (BM25 + Vector + RRF), re-ranking (Cohere, LLM, vLLM), search gate, and progress reporting.</Description>
    <PackageTags>AI;RAG;Pipeline;TextSplitter;Embedding;ContextBuilder;HybridSearch;BM25;Reranking</PackageTags>
    <PackageProjectUrl>https://github.com/AJ-comp/Mythosia.AI/tree/main/rag/Mythosia.AI.Rag</PackageProjectUrl>
    <PackageReleaseNotes>v5.0.0: Breaking — RagPipelineOptions unified via DefaultQuery (RagQueryOptions with FinalFilter/RetrievalDerivation), AugmentedPrompt renamed to RequestMessageContent, LlmQueryRewriter returns QueryRewriteResult with search gate. Added VllmEmbeddingProvider, VllmReranker, RagStore.QueryAsync with conversation history, progress reporting.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\loaders\Mythosia.AI.Loaders.Office\Mythosia.AI.Loaders.Office.csproj" />
    <ProjectReference Include="..\..\loaders\Mythosia.AI.Loaders.Pdf\Mythosia.AI.Loaders.Pdf.csproj" />
    <ProjectReference Include="..\Mythosia.AI.Rag.Abstractions\Mythosia.AI.Rag.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Mythosia.AI\Mythosia.AI.csproj" />
    <ProjectReference Include="..\..\vectordb\Mythosia.VectorDb.InMemory\Mythosia.VectorDb.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mythosia.AI.Rag.Tests" />
  </ItemGroup>

</Project>

